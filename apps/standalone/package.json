{
  "name": "@callout-relay/standalone",
  "version": "0.5.2",
  "private": true,
  "description": "Callout Relay desktop app: translated game comms to your friend's phone",
  "author": "Callout Relay",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.typecheck.json --noEmit",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "dist": "pnpm typecheck && pnpm build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sherpa-onnx-node": "^1.13.7",
    "tar": "7.5.22",
    "unbzip2-stream": "1.4.3"
  },
  "devDependencies": {
    "@callout-relay/companion": "workspace:*",
    "@callout-relay/relay": "workspace:*",
    "@callout-relay/shared": "workspace:*",
    "@types/node": "^22.10.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.calloutrelay.app",
    "productName": "Callout Relay",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Callout Relay",
      "artifactName": "CalloutRelay-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CalloutRelay-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "imbafls",
        "repo": "relay_translator"
      }
    ],
    "asarUnpack": [
      "dist/localSttWorker.js",
      "**/node_modules/sherpa-onnx-node/**",
      "**/node_modules/sherpa-onnx-win-x64/**"
    ]
  }
}
