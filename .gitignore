# streamdeck: the plugin was dropped in 1acd94e, with the loopback control API
# it was the only user of. Nothing under apps/streamdeck is source any more -
# these rules stay because a working copy from before that still has the
# generated bin/ and imgs/ sitting there, and they are not to be committed now.
apps/streamdeck/*.sdPlugin/bin/
apps/streamdeck/*.sdPlugin/imgs/

# SEA build artifacts
packages/relay/sea/sea-prep.blob
packages/relay/sea/*.exe
packages/relay/sea/callout-relay-server*
packages/relay/sea/relay-bundle.cjs

# local dev tooling (browser preview / mock relay launch config)
.claude/

# knowledge graph build output (graphify)
graphify-out/

# marketing / seo planning scratch — not part of the product
.marketing/

# AI handoff package (docs + copied secrets) - never commit
_handoff/

# personal scratch note - not part of the product
IDEA.md
