# .env deployed next to callout-relay-server on the VPS (/opt/callout-relay/.env)
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
RELAY_PORT=8787

# Set both. Leave them empty and the relay mints random tokens on first boot
# (config.ts loadState) and keeps them only in relay-state.json in its own data
# directory - so the token the desktop app needs is a value nobody wrote down
# and nothing can reach without logging into the box, and wiping the data dir
# silently mints a new pair, breaking every viewer link already handed out.
#
#   RELAY_PUBLISHER_TOKEN  the desktop app's "publisher token" field. Authorises
#                          /ws/uplink and the admin endpoints.
#   RELAY_VIEWER_TOKEN     the token in the /watch/<token> link viewers open.
#
# Any long random string; the value here and the one in the app must match.
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
RELAY_PUBLISHER_TOKEN=
RELAY_VIEWER_TOKEN=
